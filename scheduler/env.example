# Rayern snapshot scheduler — configuration

The scheduler is a standalone service. It should be deployed as its own Render
web service with a persistent disk for `SCHEDULER_STATE_PATH`.

# Rayern wake endpoint (POST). Required.
RAYERN_WAKEUP_ENDPOINT=https://rayern-api.onrender.com/internal/dashboard-wakeup

# Wake credential (server-side only; never in a browser, never logged). Required.
RAYERN_MONITORING_TOKEN=

# Cadence. Default 7200000 ms = two hours. Minimum 5 minutes.
SCHEDULER_INTERVAL_MS=7200000

# First-run policy. 0 (default) = wait for the next interval; 1 = run at boot.
SCHEDULER_RUN_ON_START=0

# Per-request timeout (Rayern on Render Free may cold-start).
SCHEDULER_REQUEST_TIMEOUT_MS=90000

# Retries for TRANSIENT failures only (429, 5xx, timeouts, network).
# Authentication and validation failures are never retried.
SCHEDULER_MAX_RETRIES=3
SCHEDULER_RETRY_BASE_MS=30000
SCHEDULER_RETRY_MAX_MS=600000

# Abandoned run-lock TTL (prevents duplicate runs after a crash).
SCHEDULER_LOCK_TTL_MS=900000

# Durable state (mount a persistent disk at /var/data in production).
SCHEDULER_STATE_PATH=/var/data/scheduler-state.json
SCHEDULER_HISTORY_LIMIT=100

# HTTP listener for /health and /status.
PORT=4100
SCHEDULER_HOST=0.0.0.0

# Dedicated read-only credential for GET /status. The dashboard backend holds
# this value (SCHEDULER_STATUS_TOKEN) and proxies the request server-side.
SCHEDULER_STATUS_TOKEN=
