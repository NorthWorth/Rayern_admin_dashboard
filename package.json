{
  "name": "rayern-admin-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "sh ./scripts/dev-full.sh",
    "dev:client": "cd client && bun run dev",
    "dev:server": "cd server && bun run dev",
    "build": "cd client && bun run build",
    "typecheck": "cd client && bun tsc -b --noEmit && cd ../server && bun tsc --noEmit",
    "check": "npm run typecheck",
    "smoke": "cd server && bun run smoke"
  }
}
