# Dashboard frontend configuration (Vite exposes only VITE_* vars to the browser)

# Base URL of the dedicated admin/dashboard backend API.
# Leave unset when using built-in demo data; set it when the dashboard backend is available.
VITE_ADMIN_API_URL=

# Set to "1" to force demo data even if VITE_ADMIN_API_URL is configured.
VITE_ADMIN_USE_DEMO_DATA=1

# Optional: feature flag consumed by the backend, never a secret.
# VITE_ADMIN_FEATURE_FLAG=
