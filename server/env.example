# Rayern Admin Dashboard — backend configuration (copy to server/.env and fill in)

# HTTP port the dashboard API listens on (API_PORT wins over PORT so the
# frontend dev server and the API can run side by side in dev)
PORT=4000

# Database (PostgreSQL). Own database, completely separate from Rayern.
# When unset, the backend transparently boots an embedded Postgres (PGlite)
# for zero-config local development. Production MUST set this.
DATABASE_URL=

# CA certificate (PEM) of the managed Postgres provider (e.g. Aiven).
# Paste the full multi-line certificate. When set, the Pool pins this CA with
# rejectUnauthorized: true so SSL verification succeeds on sslmode=require
# hosts (fixes SELF_SIGNED_CERT_IN_CHAIN). Leave unset for local dev.
DATABASE_CA_CERT=

# Secrets — generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=

# CORS: comma-separated list of allowed dashboard frontend origins.
# The production frontend origin (https://admin.rayern.com.ng) is always
# allowed in production; add extra origins here if needed. Never use '*'.
CORS_ORIGINS=http://localhost:5173

# Bootstrap admin credentials, used only to create the first admin on first boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Resend (server-side only — never exposed to the browser)
RESEND_API_KEY=

# Verified sender enforced for all dashboard-sent emails
EMAIL_FROM_NAME=Rayern
EMAIL_FROM_ADDRESS=support@rayern.com.ng

# Dev/test only: validate + record emails without calling Resend
EMAIL_DRY_RUN=1

# Optional: default window (days) for registration trend charts
REGISTRATION_TREND_DAYS=90

# Set true to serve the compiled dashboard frontend from this server (single origin)
SERVE_STATIC=false

# ---------------------------------------------------------------------------
# Rayern pull-sync (dashboard-side worker — Rayern never calls the dashboard)
# ---------------------------------------------------------------------------
# The dashboard periodically GETs approved aggregate metrics from Rayern.
# Configure these once the real Rayern metrics endpoint exists. Until then,
# synchronization is disabled and aggregate data stays empty.
#
# Either the full endpoint URL …
RAYERN_SYNC_ENDPOINT=
# … or a base URL + the documented default path (/internal/dashboard-metrics)
RAYERN_API_BASE_URL=

# Bearer token Rayern expects for that endpoint (lives only on this server).
RAYERN_MONITORING_TOKEN=

# Schedule + safety (defaults shown). Default interval is 30 minutes (1800000)
# so the pull loop stays clear of Rayern's rate limits.
RAYERN_SYNC_INTERVAL_MS=1800000
RAYERN_SYNC_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Telemetry (OpenTelemetry) — all optional. Every one of these can stay unset:
# the API starts, serves requests, and never fails because of telemetry.
# ---------------------------------------------------------------------------
# Master switch for the dashboard's own telemetry (spans, request/DB metrics,
# System + Observability pages). The standard OTEL_SDK_DISABLED=true also
# turns it off. When disabled, unavailable metrics are reported as null.
TELEMETRY_ENABLED=true

# OTLP/HTTP traces endpoint. Unset = no external export (local telemetry only).
# Base endpoint (the /v1/traces suffix is appended automatically) …
OTEL_EXPORTER_OTLP_ENDPOINT=
# … or the full traces URL:
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Standard OTLP auth headers, comma-separated key=value pairs (values
# percent-encoded), e.g. Grafana Cloud / Honeycomb style api-key headers.
OTEL_EXPORTER_OTLP_HEADERS=

# Standard OTel service identity + sampler. Sampler only affects OTLP export:
# always_on (default) | always_off | traceidratio (ratio in *_ARG, e.g. 0.1).
OTEL_SERVICE_NAME=rayern-admin-dashboard-api
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
TELEMETRY_ENVIRONMENT=production

# Optional tuning (defaults shown)
TELEMETRY_SLOW_REQUEST_MS=1000
TELEMETRY_SLOW_QUERY_MS=250
TELEMETRY_FLUSH_MS=10000
TELEMETRY_TRACE_RETENTION_HOURS=48
TELEMETRY_REQUEST_LOG_RETENTION_HOURS=168
TELEMETRY_SPAN_METRICS_RETENTION_HOURS=168

# Deterministic health thresholds (System page healthy/degraded/failing).
# Metrics are reported as null until HEALTH_MIN_SAMPLES are measured.
HEALTH_MIN_SAMPLES=10
HEALTH_ERROR_RATE_DEGRADED_PCT=1
HEALTH_ERROR_RATE_FAILING_PCT=5
HEALTH_LATENCY_P95_DEGRADED_MS=500
HEALTH_LATENCY_P95_FAILING_MS=2000
HEALTH_AVAILABILITY_DEGRADED_PCT=99
HEALTH_AVAILABILITY_FAILING_PCT=95
HEALTH_DB_ERROR_RATE_DEGRADED_PCT=1
HEALTH_DB_ERROR_RATE_FAILING_PCT=10
